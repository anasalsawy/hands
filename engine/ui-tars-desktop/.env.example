# UI-TARS Desktop — engine provider = Persona (the mind, hosted on Railway)
#
# The engine (this app, ByteDance UI-TARS) holds no model of its own.
# It is an OpenAI-compatible client; here it points at the HOSTED Persona
# server, so the engine's LLM *is* Persona (the R lanes).
#
# Hosted Persona (Railway):  https://dl-companion-production.up.railway.app
#   GET  /health                 -> 200
#   GET  /v1/models              -> "sawii-persona"
#   POST /v1/chat/completions    -> requires Authorization: Bearer sp_... (Persona key)
#
# VLM_PROVIDER must read exactly "Persona" (VLMProviderV2.persona).
# VLM_API_KEY is your Persona identity key (sp_...). Do not commit a real key;
# put it in a local .env, not this example.
VLM_PROVIDER=Persona
VLM_BASE_URL=https://dl-companion-production.up.railway.app/v1
VLM_API_KEY=sp_your_persona_key
VLM_MODEL_NAME=sawii-persona
