diff --git a/browser_use/persona/observer.py b/browser_use/persona/observer.py
index f500c96..d25af7d 100644
--- a/browser_use/persona/observer.py
+++ b/browser_use/persona/observer.py
@@ -97,6 +97,52 @@ class BrowserObserver:
 		self._capture_lock = asyncio.Lock()
 		self._observation_task: asyncio.Task | None = None
 
+	async def fingerprint(self) -> tuple[str, str, str, str]:
+		"""Cheap action-safety read: target + DOM-visible state, no screenshot."""
+		if self._capture_override:
+			raw = await self._capture_override()
+			target = str(raw['target_id'])
+			state = str(raw['page_state'])
+			return hashlib.sha256((target + '\n' + state).encode()).hexdigest(), target, str(raw.get('url','')), str(raw.get('title',''))
+		cdp = await self.browser_session.get_or_create_cdp_session(focus=False)
+		target = str(cdp.target_id)
+		result = await cdp.cdp_client.send.Runtime.evaluate(
+			params={'expression': _READ_STATE, 'returnByValue': True}, session_id=cdp.session_id
+		)
+		if result.get('exceptionDetails'):
+			raise RuntimeError('Browser state evaluation failed')
+		state = result.get('result', {}).get('value')
+		if not isinstance(state, str):
+			raise RuntimeError('Browser state evaluation returned no state')
+		data = json.loads(state)
+		digest = hashlib.sha256((target + '\n' + state).encode()).hexdigest()
+		return digest, target, data.get('url',''), data.get('title','')
+
+	def ingest_native_state(self, state, *, state_digest: str, target_id: str) -> BrowserFrame:
+		"""Reuse Browser Use's native DOM+screenshot as L's observation frame.
+
+		No second screenshot is taken. The selector map remains the exact native
+		state R will consume on this step.
+		"""
+		screenshot = state.screenshot or ''
+		dom_text = state.dom_state.llm_representation() if state.dom_state else ''
+		page_state = json.dumps({'url': state.url, 'title': state.title, 'dom': dom_text[:14000]}, ensure_ascii=False)
+		previous = self.latest
+		visual_digest = hashlib.sha256(screenshot.encode()).hexdigest() if screenshot else ''
+		changed = previous is None or (previous.state_digest, previous.visual_digest) != (state_digest, visual_digest)
+		frame = BrowserFrame(
+			revision=(previous.revision if previous else 0) + int(changed),
+			captured_at=time.monotonic(), target_id=target_id, state_digest=state_digest,
+			visual_digest=visual_digest, url=state.url, title=state.title,
+			page_state=page_state, screenshot=screenshot,
+		)
+		self.latest = frame
+		if changed:
+			if previous and previous.state_digest != state_digest and self._observation_task:
+				self._observation_task.cancel()
+			self._changed.set()
+		return frame
+
 	async def _capture(self) -> dict:
 		if self._capture_override:
 			return await self._capture_override()
