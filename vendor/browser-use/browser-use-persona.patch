+def frame(state='page A', image='image A'):
+    return {'target_id':'tab-1','page_state':state,'url':'https://example.test','title':'Test','screenshot':image}
+
+
+async def until(predicate):
+    async with asyncio.timeout(2):
+        while not predicate():
+            await asyncio.sleep(0.005)
+
