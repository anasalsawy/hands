+@pytest.mark.asyncio
+async def test_L_observes_while_R_decision_is_in_flight(observer_module):
+    m=observer_module
+    r_entered=asyncio.Event()
+    release_r=asyncio.Event()
+    observations=[]
+    class Lanes:
+        async def execute(self):
+            r_entered.set()
+            await release_r.wait()
+        async def conversation(self,messages):
+            assert r_entered.is_set() and not release_r.is_set()
+            observations.append(messages)
+            yield 'A required field is visible.'
+    async def capture(): return frame()
+    lanes=Lanes()
+    r=asyncio.create_task(lanes.execute())
+    await r_entered.wait()
+    observer=m.BrowserObserver(lanes,None,m.ObserverSettings(sample_interval=.1,inference_interval=.1),capture=capture)
+    observer.start()
+    try:
+        await until(lambda: observer.observation is not None)
+        assert not r.done()
+        assert 'required field' in observer.note_for(observer.latest)
+        assert observations[0][1]['content'][1]['image_url']['url'].startswith('data:image/jpeg;base64,')
+    finally:
+        release_r.set()
+        await r
+        await observer.close()
+    assert not observer.running
+
