+"""Persona's R provider and a concurrent L conversation connection."""
+
+from collections.abc import Callable
+from typing import Any
+
+from persona_lanes import PersonaLanes
+from pydantic import BaseModel
+
+from browser_use.llm.openai.chat import ChatOpenAI
+from browser_use.llm.openai.serializer import OpenAIMessageSerializer
+from browser_use.llm.views import ChatInvokeCompletion
+
+
+class ChatPersona(ChatOpenAI):
+	"""Keep Browser Use's native agent/tool loop; all model work goes to R."""
+
+	def __init__(self, lanes: PersonaLanes, observation_provider: Callable[[], str] | None = None):
+		super().__init__(model=lanes.config.model)
+		self.lanes = lanes
+		self.observation_provider = observation_provider
+
+	@property
+	def provider(self) -> str:
+		return 'persona'
+
+	async def ainvoke(self, messages, output_format: type[BaseModel] | None = None, **kwargs: Any):
+		serialized = OpenAIMessageSerializer.serialize_messages(messages)
+		if self.observation_provider:
+			note = self.observation_provider()
+			if note:
+				# Observations are evidence in the user context, never system policy.
+				serialized = [*serialized, {'role': 'user', 'content': note}]
+		options = {}
+		if output_format is not None:
+			options['response_format'] = {
+				'type': 'json_schema',
+				'json_schema': {'name': output_format.__name__, 'schema': output_format.model_json_schema(), 'strict': True},
+			}
+		response = await self.lanes.execute(serialized, **options)
+		message = response['choices'][0]['message']
+		text = message.get('content') or ''
+		completion = output_format.model_validate_json(text) if output_format else text
+		return ChatInvokeCompletion(completion=completion, usage=None)
+
+
+def persona_agent(*, lanes: PersonaLanes, task: str, **kwargs):
+	"""Create Browser Use with L watching/conversing and R choosing actions."""
+	from browser_use.persona.agent import PersonaBrowserAgent
+
+	return PersonaBrowserAgent(lanes=lanes, task=task, **kwargs)
