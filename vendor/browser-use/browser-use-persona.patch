+"""Adapter contracts with native serializers/schemas; no browser/cloud credentials."""
+import importlib
+import json
+import sys
+import types
+from pathlib import Path
+
+import httpx
+import pytest
+from pydantic import BaseModel
+
+from persona_lanes import LaneConfig, PersonaLanes
+
+ROOT = next(p for p in Path(__file__).resolve().parents if (p / 'browser-use-persona').is_dir())
+
+
+def namespace(monkeypatch, name, path):
+    module = types.ModuleType(name)
+    module.__path__ = [str(path)]
+    monkeypatch.setitem(sys.modules, name, module)
+
+
+@pytest.mark.asyncio
