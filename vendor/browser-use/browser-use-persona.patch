+"""Browser Use's existing Agent with independent L observation and R actions."""
+
+from __future__ import annotations
+
+from browser_use.agent.service import Agent
+from browser_use.llm.persona import ChatPersona
+from browser_use.persona.observer import BrowserObserver, ObserverSettings, StaleBrowserState
+
+
+class PersonaBrowserAgent(Agent):
+	"""Preserve the native task loop and tools; observe in parallel, guard actions."""
+
+	def __init__(self, *, lanes, task: str, observer_settings: ObserverSettings | None = None, **kwargs):
+		for key in ('llm', 'page_extraction_llm', 'judge_llm', 'fallback_llm'):
+			if key in kwargs:
+				raise ValueError(f'{key} is owned by Persona R')
+		if kwargs.get('message_compaction') is not None and not isinstance(kwargs['message_compaction'], bool):
+			raise ValueError('custom compaction models must be configured through Persona R')
+		if kwargs.get('max_actions_per_step', 1) != 1:
+			raise ValueError('Persona observation mode uses one action per refreshed browser state')
+		kwargs['max_actions_per_step'] = 1
+		self._persona_observer_settings = observer_settings or ObserverSettings()
+		self._persona_decision_frame = None
+		self._persona_running = False
+		self._persona_observer = None
+		model = ChatPersona(lanes, observation_provider=self._persona_note)
+		super().__init__(task=task, llm=model, page_extraction_llm=model, judge_llm=model, **kwargs)
+		self.persona_lanes = lanes
+
+	@property
+	def persona_observer(self) -> BrowserObserver | None:
+		return self._persona_observer
+
+	def _persona_note(self) -> str:
+		if self._persona_observer is None:
+			return ''
+		return self._persona_observer.note_for(self._persona_decision_frame)
+
+	async def run(self, *args, **kwargs):
+		if self._persona_running:
+			raise RuntimeError('This Persona agent already has an active run')
+		self._persona_running = True
+		# Attach the sampler only after the browser is available in _prepare_context.
+		try:
+			return await super().run(*args, **kwargs)
+		finally:
+			if self._persona_observer:
+				await self._persona_observer.close()
+			self._persona_running = False
+
+	async def close(self):
+		if self._persona_observer:
+			await self._persona_observer.close()
+		return await super().close()
+
+	async def _prepare_context(self, step_info=None):
+		if self._persona_observer is None:
+			self._persona_observer = BrowserObserver(self.persona_lanes, self.browser_session, self._persona_observer_settings)
+		observer = self._persona_observer
+		if self._persona_running and not observer.running:
+			observer.start()
+		# R's selector cache must be built from a stable page. The parallel
+		# sampler reads CDP directly and never overwrites that cache.
+		before = await observer.sample()
+		summary = await super()._prepare_context(step_info)
+		after = await observer.sample()
+		if before.state_digest != after.state_digest:
+			raise StaleBrowserState('Browser changed during context preparation; retry with fresh state')
+		self._persona_decision_frame = after
+		return summary
+
+	async def _execute_actions(self):
+		if self._persona_observer is None or self._persona_decision_frame is None:
+			raise StaleBrowserState('No current browser frame exists for this decision')
+		# If L saw a new dialog/page while R was generating, discard R's stale
+		# action. Browser Use's normal step retry rebuilds DOM and asks R again.
+		await self._persona_observer.assert_current(self._persona_decision_frame)
+		return await super()._execute_actions()
+
+	async def conversation(self, messages):
+		"""The user may talk to L while this agent's run() task remains active."""
+		frame = self._persona_observer.latest if self._persona_observer else None
+		note = self._persona_observer.note_for(frame) if self._persona_observer else ''
+		transcript = list(messages)
+		if note:
+			transcript = [
+				{
+					'role': 'system',
+					'content': 'Read-only browser observation for answering the user. Do not claim execution success.\n' + note,
+				},
+				*transcript,
+			]
+		async for piece in self.persona_lanes.conversation(transcript):
+			yield piece
