+@pytest.mark.asyncio
+async def test_old_L_result_is_cancelled_and_newest_frame_wins(observer_module):
+    m=observer_module
+    state=[frame('A')]
+    started=asyncio.Event()
+    cancelled=asyncio.Event()
+    seen=[]
+    class Lanes:
+        async def conversation(self,messages):
+            prompt=messages[0]['content']
+            seen.append(prompt)
+            if prompt.endswith('\nA'):
+                started.set()
+                try:
+                    await asyncio.Event().wait()
+                finally:
+                    cancelled.set()
+            yield 'New screen observed.'
+    async def capture(): return state[0]
+    observer=m.BrowserObserver(Lanes(),None,m.ObserverSettings(sample_interval=.1,inference_interval=.1),capture=capture)
+    observer.start()
+    try:
+        await asyncio.wait_for(started.wait(),1)
+        state[0]=frame('B')
+        await observer.sample()
+        state[0]=frame('C')
+        await observer.sample()
+        await asyncio.wait_for(cancelled.wait(),1)
+        await until(lambda: observer.observation is not None)
+        assert seen[-1].endswith('\nC')
+        assert observer.observation.state_digest == observer.latest.state_digest
+        assert len(seen) == 2  # no backlog of B frames
+    finally:
+        await observer.close()
