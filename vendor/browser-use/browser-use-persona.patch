+"""Exercise concurrent observation and guarded action lifecycle without Chrome."""
+import asyncio
+import importlib
+import sys
+import time
+import types
+from pathlib import Path
+
+import pytest
+
+ROOT = next(p for p in Path(__file__).resolve().parents if (p / 'browser-use-persona').is_dir())
+
+
+@pytest.fixture
+def observer_module(monkeypatch):
+    base = ROOT / 'browser-use-persona/browser_use'
+    for name, path in [('browser_use',base), ('browser_use.persona',base/'persona')]:
+        module=types.ModuleType(name)
+        module.__path__=[str(path)]
+        monkeypatch.setitem(sys.modules,name,module)
+    return importlib.import_module('browser_use.persona.observer')
